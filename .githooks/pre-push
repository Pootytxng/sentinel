#!/bin/sh
# Run the local verification gate (scripts/verify-local.ps1) before anything is pushed.
set -eu

# A stray `core.bare = true` in the shared .git/config makes git refuse every work-tree operation.
if [ "$(git config --get core.bare || echo false)" = "true" ]; then
  echo "pre-push: .git/config has core.bare=true. Repair with:  git config core.bare false" >&2
  exit 1
fi

repo="$(git -c safe.directory="$PWD" rev-parse --show-toplevel)"

# Scrub git's hook environment before handing off. Git exports GIT_DIR (and friends) to every hook;
# the test suite builds REAL git fixtures, and under these variables they retarget the developer's
# actual repository (this hook once wrote core.bare=true into the real .git/config).
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_NAMESPACE \
      GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH \
      GIT_PREFIX GIT_REFLOG_ACTION 2>/dev/null || true

# A push that only DELETES refs cannot introduce code: skip the gate (all-zero local sha per line).
refs="$(cat)"
if [ -n "$refs" ] && ! printf '%s\n' "$refs" | grep -qv '^[^ ]* 0\{40\} '; then
  echo "pre-push: deletion-only push, nothing to verify - gate skipped." >&2
  exit 0
fi

# Fail CLOSED when the gate cannot run: a skipped gate looks identical to a passed one.
if [ ! -f "$repo/scripts/verify-local.ps1" ]; then
  echo "pre-push: $repo has no scripts/verify-local.ps1 - the gate cannot run here. Refusing to push unverified code." >&2
  exit 1
fi
if ! command -v powershell.exe >/dev/null 2>&1; then
  echo "pre-push: powershell.exe is not on PATH, so the gate cannot run. Refusing to push unverified code." >&2
  exit 1
fi

rc=0
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo/scripts/verify-local.ps1" || rc=$?
if [ "$rc" -ne 0 ]; then
  case "$rc" in
    127|130) echo "pre-push: the gate process was TERMINATED, not failed (exit $rc): nothing was proven. Push again." >&2 ;;
  esac
  exit "$rc"
fi
