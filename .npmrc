# bug->guard (2026-07-23): agent tooling on this box runs with NODE_ENV=production injected
# into its process tree, which makes a plain `npm install` PRUNE all devDependencies (vite,
# typescript, vitest, @tauri-apps/cli - live-caught: 402 packages removed mid-session).
# This forces dev deps for THIS repo no matter what the environment claims.
include=dev
