-  return {
-    action: notes.length ? "reported" : "clean",
-    line: notes.length ? `compy-entry: worktree provisioning DIAGNOSED, nothing written — ${notes.join("; ")}` : null,
-    hooksPath,
-    lineEndings,
-  };
-}
