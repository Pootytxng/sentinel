-    if (n === 0) list = false;
-    return "top";
-  };
-  return String(body ?? "").replace(/^\uFEFF/, "").replace(/\r\n?/g, "\n").split("\n").map((l) => {
-    if (lost) return strict ? "" : l;
-    const n = indent(l);
-    if ((fence ?? comment ?? html)?.deep > n && /\S/.test(l)) {
