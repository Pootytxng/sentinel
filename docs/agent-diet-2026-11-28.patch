-  const extension = run(root, ["config", "--get", "extensions.worktreeConfig"]);
-  if (!extension.ok || extension.out !== "true") {
-    return {
-      action: "escapes",
-      from: raw.out,
-      reason: "and extensions.worktreeConfig is not true, so a per-worktree repoint is not available here",
-    };
-  }
