-  }
-  if (hookInput?.cwd) {
-    return { root: canonicalizePath(hookInput.cwd), source: "hook cwd", observed: true };
-  }
-  return { root: canonicalizePath(cwd), source: "process.cwd() (inferred)", observed: false };
