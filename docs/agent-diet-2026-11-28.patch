-  // it was the one name missing: the whole point of a claim is that two writers never share a
-  // worktree, and the probe could not see the other writer at all.
-  "claude.exe",
-  "cargo.exe",
-  "rustc.exe",
-  "node.exe",
-  "npm.exe",
-  "msbuild.exe",
-  "Code.exe",
