+/**
+ * The thread as the CLI asks it: once per issue per ten minutes, whatever it answers (#468).
+ * claimFor caches only a live claim with a scope, so a released claim, an issue never claimed or
+ * a GitHub that does not answer sent every tool call back to the thread -- about 0.4 s and one
+ * GraphQL request each, or this hook's whole timeout while GitHub hangs. What claimFor decides
+ * from an answer does not change; only how often it asks.
+ */
+export function cliThread({ read, cacheDir = claimCacheDir(), now = new Date() }) {
+  return boundedThread(read, { dir: cacheDir, now });
