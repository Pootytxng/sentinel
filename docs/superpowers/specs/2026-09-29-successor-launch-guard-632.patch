+#!/usr/bin/env node
+// PreToolUse(spawn_task | run_scheduled_task) hook — successor launch guard (#632).
+//
+// A prompt that claims to be a successor handoff launches only as
+// `node scripts/successor-route.mjs --handoff <file>` prints it, for a Handoff whose next action can
+// start now; every other chip and routine passes untouched. The logic and its tests live in
+// scripts/successor-launch-guard.mjs; this file only wires it. Fails OPEN on any error: a broken
+// guard must not block every chip.
+
+import { readFileSync } from "node:fs";
+
+try {
+  const { hookOutput } = await import("../../scripts/successor-launch-guard.mjs");
+  const out = hookOutput(readFileSync(0, "utf8"));
+  if (out) process.stdout.write(JSON.stringify(out));
+} catch {
+  // fail open
+}
