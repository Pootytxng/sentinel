+/**
+ * The launch token's issue, but only for the folder the token names and only until it expires. The
+ * token is one file per machine, not per folder: read without both checks, a launch for
+ * `sentinel-pilot-b-363` that expired on 2026-09-03 told every unclaimed folder to claim #363 (#463).
+ * These are the two checks `verifySession` makes before a token may reach a session record, with one
+ * difference: an expiry that cannot be read counts as expired here, so a suggestion is this folder's
+ * or it is absent.
+ */
+export function tokenIssueFor({ token, root, now = new Date() } = {}) {
+  if (!root || !token || token === CORRUPT || !Number.isInteger(token.issue)) return null;
+  if (typeof token.folder !== "string" || !samePath(token.folder, root)) return null;
+  const expires = Date.parse(token.expiresAt ?? "");
+  return Number.isFinite(expires) && expires >= now.getTime() ? token.issue : null;
+}
