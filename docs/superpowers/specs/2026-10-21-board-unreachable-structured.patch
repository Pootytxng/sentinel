+// ── the ONE machine-readable BOARD_UNREACHABLE blocker (#445 option 2, owner-accepted 2026-10-21) ──
+//
+// Duplicated from scripts/lib/board-blocker.mjs on purpose (this file imports nothing but `node:`)
+// and pinned equal to it by tools/entry/session-root-assert.test.mjs: the session's "the board was
+// unknown" and the gate's must be the same words, so no reader has to parse prose to learn it.
+// Unknown board state is never a PASS and never an exemption; the proof-dependent transitions wait
+// for an authenticated fresh read (within BOARD_TTL_MINUTES) plus every native gate on the head.
+
+export const BOARD_HELD_TRANSITIONS = Object.freeze(["mark-pr-ready", "close-superseded-pr", "merge-pr", "close-issue", "mark-done"]);
+
+export const BOARD_UNREACHABLE_CONSEQUENCES = Object.freeze([
+  "unknown board state is never a PASS and never an exemption",
+  `${BOARD_HELD_TRANSITIONS.join(", ")} wait for an authenticated fresh Work Control read (within ${BOARD_TTL_MINUTES} minutes, recorded as boardRead on the receipt)`,
+  "every native gate on the exact head stays required; this blocker cannot be substituted",
+  "the hosted lane finishes authoring and pre-proof and hands off blocked evidence",
+]);
+
+/** The blocker as data: the code, the transition being refused (when there is one), why, and the consequences. */
+export function boardUnreachableBlocker({ transition = null, why = "Work Control could not be read" } = {}) {
+  return {
+    code: "BOARD_UNREACHABLE",
+    ...(transition ? { transition } : {}),
+    why: String(why),
+    consequences: [...BOARD_UNREACHABLE_CONSEQUENCES],
+  };
+}
+
+/** One line a human and a grep can both read: the code first, then why, then the consequences. */
+export function renderBoardUnreachable(blocker) {
+  const head = `${blocker.code}${blocker.transition ? ` (${blocker.transition})` : ""}: ${blocker.why}`;
+  return `${head}. Consequences: ${blocker.consequences.join("; ")}.`;
+}
