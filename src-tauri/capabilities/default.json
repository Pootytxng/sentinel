{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the telemetry overlay window",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "ms-settings:display-advanced" },
        { "url": "ms-settings:display-advancedgraphics" },
        { "url": "ms-settings:storagesense" },
        { "url": "https://www.hwinfo.com/download/" }
      ]
    }
  ]
}
