{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MAIN WINDOW ONLY. Every custom Compy command, plus the plugin permissions the product UI needs. The telemetry overlay is deliberately excluded and carries its own minimal capability (capabilities/overlay.json) — before 2026-08-03 this file listed both windows and custom commands were outside the capability system entirely, so the overlay inherited authority over all 91 commands including apply, rollback, license-key and the update-restart barrier. src/command-authority-guard.test.ts keeps this list equal to build.rs APP_COMMANDS and to the generate_handler! registration.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "ms-settings:display-advanced" },
        { "url": "ms-settings:display-advancedgraphics" },
        { "url": "ms-settings:storagesense" },
        { "url": "https://www.hwinfo.com/download/" },
        { "url": "https://github.com/LibreHardwareMonitor/LibreHardwareMonitor/releases" }
      ]
    },
    "allow-acknowledge-hardware-changes",
    "allow-apply-recommendation",
    "allow-apply-recommendations-batch",
    "allow-arm-comparison",
    "allow-arm-tuning",
    "allow-begin-update-restart",
    "allow-cancel-benchmark",
    "allow-cancel-trial",
    "allow-cancel-update-restart",
    "allow-clear-benchmark-baseline",
    "allow-clear-scoreboard",
    "allow-clear-support-evidence",
    "allow-clear-tuning",
    "allow-conclude-experiment",
    "allow-disable-known-bloat-task",
    "allow-dismiss-comparison",
    "allow-dismiss-readiness-check",
    "allow-export-report",
    "allow-export-support-evidence",
    "allow-gaming-mode-enabled",
    "allow-gaming-session-is-live",
    "allow-get-appliable-rec-ids",
    "allow-get-applied-changes",
    "allow-get-armed-comparison",
    "allow-get-benchmark-state",
    "allow-get-build-stamp",
    "allow-get-component-evidence",
    "allow-get-cpu-sensors",
    "allow-get-cpu-temp",
    "allow-get-crash-blackbox",
    "allow-get-diagnostics",
    "allow-get-experiment-gate",
    "allow-get-experiments",
    "allow-get-fan-sensors",
    "allow-get-fps-status",
    "allow-get-game-readiness",
    "allow-get-gaming-session-state",
    "allow-get-gpu-sensors",
    "allow-get-hardware-changes",
    "allow-get-hardware-info",
    "allow-get-intelligence-headline",
    "allow-get-intelligence-patterns",
    "allow-get-intelligence-timeline",
    "allow-get-latency-diagnostics",
    "allow-get-latest-comparison",
    "allow-get-leftovers",
    "allow-get-license-status",
    "allow-get-memory-pressure",
    "allow-get-nic-driver-info",
    "allow-get-preload-apps",
    "allow-get-priorities",
    "allow-get-receipts-gate",
    "allow-get-recommendations",
    "allow-get-rules-source",
    "allow-get-scoreboard",
    "allow-get-session-summaries",
    "allow-get-startup-entries",
    "allow-get-trial-state",
    "allow-hide-overlay",
    "allow-latency-measure-mouse",
    "allow-latency-measure-wake",
    "allow-open-export-folder",
    "allow-overlay-visible",
    "allow-preview-receipt-payload",
    "allow-preview-support-evidence",
    "allow-priorities-from",
    "allow-recover-gaming-session",
    "allow-remove-known-preload-app",
    "allow-report-tuning-crash",
    "allow-restore-experiment",
    "allow-restore-leftover",
    "allow-restore-readiness-check",
    "allow-rollback-change",
    "allow-set-benchmark-baseline",
    "allow-set-close-to-tray",
    "allow-set-keep-game-mode",
    "allow-set-license-key",
    "allow-set-overlay-corner",
    "allow-set-startup-entry-enabled",
    "allow-show-overlay",
    "allow-simulate-optimization",
    "allow-stack-trial-armed",
    "allow-start-benchmark",
    "allow-start-calibration",
    "allow-start-experiment",
    "allow-start-fps-capture",
    "allow-start-gaming-session",
    "allow-start-stack-trial",
    "allow-start-tweak-trial",
    "allow-stop-fps-capture",
    "allow-stop-gaming-session",
    "allow-suspend-known-service",
    "allow-what-changed-between",
    "allow-what-changed-for-session"
  ]
