{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "250000"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(npx vitest run *)",
      "Bash(node scripts/run-vitest.mjs *)",
      "Bash(pwsh -NoProfile -File scripts/doc-budget.ps1)",
      "Bash(node scripts/branch-disposition-audit.mjs *)",
      "Bash(node scripts/verify-release-state.mjs *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(node scripts/work-control-gate.mjs *)",
      "Bash(gh project item-list *)"
    ],
    "deny": [
      "Bash(npm publish*)",
      "PowerShell(npm publish*)",
      "Bash(cargo publish*)",
      "PowerShell(cargo publish*)",
      "Bash(gh release create*)",
      "PowerShell(gh release create*)",
      "Bash(gh pr merge*--delete-branch*)",
      "PowerShell(gh pr merge*--delete-branch*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-root-assert.mjs\"",
            "timeout": 10,
            "statusMessage": "compy-entry:session-assert"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-continue.mjs\"",
            "timeout": 20,
            "statusMessage": "autopilot: checking task queue"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-size-advisor.mjs\"",
            "timeout": 10,
            "statusMessage": "context-size advisor"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff-block-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "handoff-block guard"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/project-write-assert.mjs\"",
            "timeout": 10,
            "statusMessage": "compy-entry:write-assert"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/shell-ownership-assert.mjs\"",
            "timeout": 10,
            "statusMessage": "compy-entry:shell-ownership"
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow-usage-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "workflow-usage guard"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-model-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "subagent model-routing guard"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-throttle.mjs\"",
            "timeout": 10,
            "statusMessage": "subagent spawn-count check"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hookspath-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "isolation-worktree refusal (shared hooksPath, #362)"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/big-read-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "big-read budget guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hookspath-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shared hooksPath repair after an agent (#362)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/self-review-reminder.mjs\"",
            "timeout": 10,
            "statusMessage": "self-review reminder"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/scope-drift-check.mjs\"",
            "timeout": 10,
            "statusMessage": "compy-entry:scope-drift"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ship-reminder.mjs\"",
            "timeout": 10,
            "statusMessage": "ship-law reminder"
          }
        ]
      }
    ]
  }
}
