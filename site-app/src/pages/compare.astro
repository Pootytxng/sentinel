---
// /compare — the honest comparison page (Design Director spec, council 2026-07-15).
// Rules of the room: never name a competitor, never invent a number for software we
// haven't measured, admit our tradeoffs in the same breath. The comparison axes are
// construction practices — the one thing we can state about ourselves with receipts.
import Base from "../layouts/Base.astro";

const axes = [
  {
    tag: "AXIS 01 // ROLLBACK",
    title: "Undo is the contract, not a feature",
    compy:
      "Every change Compy applies captures its full undo recipe and a snapshot of your machine's prior state at the moment it's applied. Rollback replays that record — it never depends on the tweak still existing in our catalog. If a change can't be undone, it doesn't ship.",
    playbook:
      "“Restore” commonly means re-applying Windows defaults — not the state your PC was actually in — or a registry backup you're told to import by hand.",
    tradeoff:
      "Our catalog grows slower. Every entry has to earn its undo path before it's allowed in.",
  },
  {
    tag: "AXIS 02 // KERNEL & ANTI-CHEAT",
    title: "No kernel driver. No game injection. Ever.",
    compy:
      "FPS and frametimes come from Windows' own event stream (ETW), GPU sensors from the vendors' official libraries. Nothing touches a game's process, so there is nothing for anti-cheat to object to.",
    playbook:
      "Kernel drivers and overlay injection are the standard shortcut to deeper data — and the standard source of anti-cheat flags and blue screens.",
    tradeoff:
      "It costs us real capability: no CPU temperature on most rigs, because reading it honestly needs a kernel driver. We show the gap instead of faking the number.",
  },
  {
    tag: "AXIS 03 // CATALOG TRANSPARENCY",
    title: "The whole verdict book is public",
    compy:
      "Every tweak Compy has judged is on the record in the Blackbook — including the verdicts that read “placebo” and “risky”, and the popular tricks we refuse to ship. You can read exactly what we'd do to your PC before installing anything.",
    playbook:
      "A proprietary “optimization engine” applies an undisclosed list of changes, and the changelog is marketing copy.",
    tradeoff:
      "Publishing the reasoning means publishing the boring verdicts too. Most of PC tweaking is boring — we think you deserve to know that.",
  },
  {
    tag: "AXIS 04 // TELEMETRY DEFAULT",
    title: "Nothing leaves your PC",
    compy:
      "The app makes zero outbound network requests — no account, no analytics, no cloud. The only thing we hold is the waitlist email you type on this website.",
    playbook:
      "Analytics on by default, an account wall, and a privacy policy that lists “partners”.",
    tradeoff:
      "We fly blind on our own adoption stats. We'd rather earn the data by asking than take it by default.",
  },
  {
    tag: "AXIS 05 // COST MODEL",
    title: "Free, and the scan is never the scare",
    compy:
      "Compy's core is free forever — no account, no ads, no locked “fix” button. A paid Pro tier is in the works, but charging will only ever be for new depth, never for undoing an alarm the free scan created.",
    playbook:
      "A free scan finds hundreds of “critical issues”; the button that fixes them takes a credit card.",
    tradeoff:
      "No revenue engine behind the free app yet. That's the bet: trust first.",
  },
];
---

<Base
  title="Compy — how we're built, honestly compared"
  description="We don't have other tools' rigs — or yours — so we won't invent benchmark numbers. Here's the comparison we can make honestly: rollback, anti-cheat safety, catalog transparency, telemetry defaults, and cost model."
  path="/compare"
>
  <header class="topbar">
    <div class="wrap topbar-in">
      <a class="mono wordmark" href="/">COMPY</a>
      <a class="mono crumb" href="/">← Home</a>
    </div>
  </header>

  <main id="main" class="compare">
    <div class="wrap">
      <section class="cmp-head">
        <p class="rail"><b>COMPARE</b><span class="rail-datum">CONSTRUCTION, NOT PROMISES</span></p>
        <h1>Same category.<br />Different construction.</h1>
        <p class="cmp-intro">
          We don't have the other tools' rigs — or yours — so we won't invent benchmark
          numbers for software we haven't measured. Here's the comparison we can make
          honestly: how we're built. Five practices, ours on the record, each with the
          tradeoff it costs us.
        </p>
      </section>

      <section class="cmp-axes">
        {
          axes.map((axis) => (
            <article class="axis">
              <p class="rail">
                <b>{axis.tag}</b>
              </p>
              <h2>{axis.title}</h2>
              <div class="axis-cols">
                <div class="axis-col axis-col--compy">
                  <span class="mono axis-label axis-label--compy">HOW COMPY IS BUILT</span>
                  <p>{axis.compy}</p>
                </div>
                <div class="axis-col">
                  <span class="mono axis-label">THE USUAL PLAYBOOK</span>
                  <p>{axis.playbook}</p>
                </div>
              </div>
              <p class="axis-tradeoff">
                <span class="mono axis-label">THE TRADEOFF WE ACCEPT</span>
                {axis.tradeoff}
              </p>
            </article>
          ))
        }
      </section>

      <section class="cmp-close">
        <p class="cmp-close-line">
          Don't take the table's word for it — the verdicts are public and the app shows
          its receipts on your own hardware.
        </p>
        <div class="cmp-actions">
          <a class="btn btn--primary" href="/library/">Read the Blackbook</a>
          <a class="btn btn--ghost" href="/#waitlist">Join the waitlist</a>
        </div>
      </section>
    </div>
  </main>
</Base>

<style>
  .topbar {
    border-bottom: 1px solid var(--line);
  }
  .topbar-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
  }
  .wordmark {
    /* Canonical site-wide nameplate spec — matches landing + generated Blackbook pages. */
    font-size: 15px;
    letter-spacing: 0.32em;
    color: var(--fg);
    font-weight: 700;
  }
  .crumb {
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--fg-dim);
  }
  .crumb:hover {
    color: var(--accent-bright);
  }

  .compare {
    padding: 72px 0 96px;
  }
  .cmp-head {
    max-width: 860px;
  }
  .cmp-head h1 {
    margin: 22px 0 24px;
  }
  .cmp-intro {
    color: var(--fg-dim);
    font-size: 17.5px;
    max-width: 68ch;
    text-wrap: pretty;
  }

  .cmp-axes {
    margin-top: 84px;
    display: grid;
    gap: 72px;
  }
  .axis h2 {
    margin: 18px 0 26px;
    max-width: 760px;
  }
  .axis-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
  }
  .axis-col p {
    color: var(--fg-dim);
    font-size: 15.5px;
    max-width: 62ch;
    text-wrap: pretty;
  }
  .axis-col--compy {
    background: var(--panel);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius);
    padding: 20px 22px;
  }
  .axis-col--compy p {
    color: var(--fg);
  }
  .axis-col:not(.axis-col--compy) {
    padding: 20px 0;
  }
  /* Console legend marker: the axis label is a silk-screened instrument tag, not a
     floating eyebrow. A hollow tick reads as the reference column; a lit accent tick
     reads as the built-by-Compy column — a real datum (which side is ours), not decoration. */
  .axis-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10.5px;
    letter-spacing: 0.2em;
    color: var(--fg-faint);
    margin-bottom: 10px;
  }
  .axis-label::before {
    content: "";
    flex: none;
    width: 6px;
    height: 6px;
    border: 1px solid currentColor;
    opacity: 0.7;
  }
  .axis-label--compy {
    color: var(--accent);
  }
  .axis-label--compy::before {
    background: var(--accent);
    box-shadow: 0 0 7px rgba(255, 154, 30, 0.55);
    opacity: 1;
  }
  .axis-tradeoff {
    margin-top: 26px;
    border-top: 1px solid var(--line);
    padding-top: 14px;
    color: var(--fg-dim);
    font-size: 14.5px;
    max-width: 74ch;
  }
  .axis-tradeoff .axis-label {
    margin-bottom: 6px;
  }

  .cmp-close {
    margin-top: 96px;
    border-top: 1px solid var(--line-2);
    padding-top: 44px;
  }
  .cmp-close-line {
    color: var(--fg-dim);
    font-size: 17px;
    max-width: 62ch;
    margin-bottom: 26px;
    text-wrap: pretty;
  }
  .cmp-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
</style>
