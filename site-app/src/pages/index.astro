    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .boot-src {
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--fg-faint);
  }

  /* ---- viewport HUD corners (decorative chrome; the site IS the instrument) ---- */
  .hud-corners {
    position: fixed;
    inset: 14px;
    z-index: var(--z-hud);
    pointer-events: none;
    opacity: 0.55;
  }
  .hud-corners i {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 0 solid var(--line-2);
  }
  .hud-corners i:nth-child(1) { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
  .hud-corners i:nth-child(2) { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
  .hud-corners i:nth-child(3) { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
  .hud-corners i:nth-child(4) { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }
  @media (max-width: 920px) {
    .hud-corners { display: none; }
  }

  /* ---- topbar ---- */
  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-topbar);
    background: rgba(5, 4, 3, 0.72);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .topbar-in {
    display: flex;
    align-items: center;
    height: 60px;
    gap: 18px;
  }
  /* Unified brand mark: all-caps tracked mono, site-wide (Design Director call,
     owner-endorsed 2026-07-15) — the silk-screened instrument nameplate. */
  .wordmark {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.32em;
    color: var(--fg);
  }
  .topbar-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-faint);
    border-left: 1px solid var(--line-2);
    padding-left: 18px;
  }
  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
  }
  .topnav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 12.5px;
    letter-spacing: 0.05em;
    margin-left: auto;
  }
  .topnav a {
    color: var(--fg-dim);
  }
  .topnav a:hover {
    color: var(--accent-bright);
  }
  .topnav-cta {
    padding: 8px 16px;
    font-size: 12px;
  }
  .topnav .topnav-cta,
  .topnav a.topnav-cta:hover {
    color: var(--accent-ink);
  }
  @media (max-width: 720px) {
    .topnav a:not(.topnav-cta) {
      display: none;
    }
  }
  @media (max-width: 480px) {
    /* self-review 2026-07-14: at true 390px the CTA wrapped to two lines and overflowed the
       viewport — keep it one compact line and drop the status readout to make room. */
    .topnav-cta {
      padding: 7px 12px;
      font-size: 11px;
      white-space: nowrap;
    }
    .topbar-status {
      display: none;
    }
  }

  /* ---- flight hero ---- */
  .flight {
    position: relative;
    min-height: calc(100svh - 60px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    /* crosshair replaces the pointer over the trace (pointer:fine only, set in JS) */
  }
  .flight-wave {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* bottom scrim: the trace fades to solid ground under the copy + strip so small
     text never renders through the waveform (self-review defect, 2026-07-15). Sits
     above the canvas, below the copy (z 2) and crosshair (z 70). */
  .flight::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 62%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(5, 4, 3, 0) 0%,
      rgba(5, 4, 3, 0.62) 34%,
      rgba(5, 4, 3, 0.94) 62%,
      var(--bg) 100%
    );
  }
  @media (max-width: 860px) {
    /* the type block wraps taller at narrow widths — reach the scrim further up */
    .flight::before {
      height: 76%;
    }
  }
  .flight-xhair {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    z-index: var(--z-xhair);
    pointer-events: none;
    background: linear-gradient(180deg, transparent 8%, var(--accent-line) 40%, var(--accent-line) 92%, transparent);
  }
  .xhair-chip {
    position: absolute;
    /* rides the measured wave band, not the copy zone — flight.ts sets the var */
    top: var(--band-chip-y, 120px);
    left: 10px;
    white-space: nowrap;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--accent-bright);
    background: rgba(5, 4, 3, 0.85);
    border: 1px solid var(--accent-line);
    padding: 4px 8px;
  }
  .flight-body {
    position: relative;
    z-index: 2;
    /* reserved wave airspace: at wide viewports the justify-end slack already exceeds
       this and nothing moves; where the type fills the whole hero (≤1440) the hero
       grows past the viewport instead of letting the trace collide with the copy */
    margin-top: 150px;
    padding: clamp(28px, 5vh, 64px) clamp(20px, 4vw, 64px) 0;
    pointer-events: none; /* let the crosshair read the canvas; buttons re-enable below */
  }
  .flight-body a,
  .flight-body .flight-ctas {
    pointer-events: auto;
  }
  .flight-kick {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    border-top: 1px solid var(--line-2);
    padding-top: 12px;
    max-width: 340px;
  }
  .flight-kick b {
    font-weight: 600;
  }
  /* monumental type: the statement IS the design. Mixed fill/outline/signal lines. */
  .fh1 {
    margin: clamp(18px, 3.5vh, 40px) 0 0;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    line-height: 0.92;
    max-width: none;
    text-transform: uppercase;
  }
  .fh1-m {
    display: block;
    overflow: hidden;
    padding-right: 0.04em; /* keep the italic-ish overhang of the last glyph unclipped */
  }
  .fh1-t {
    display: block;
  }
  .fh1-small {
    font-family: var(--mono);
    font-stretch: 100%;
    font-size: clamp(12px, 1.4vw, 18px);
    font-weight: 500;
    letter-spacing: 0.3em;
    color: var(--fg-dim);
    margin-bottom: clamp(10px, 1.8vh, 22px);
  }
  .fh1-big {
    font-size: clamp(56px, 14.5vw, 224px);
    font-weight: 760;
    color: var(--fg);
  }
  .fh1-outline {
    color: transparent;
    -webkit-text-stroke: max(1.5px, 0.011em) var(--fg);
  }
  @supports not (-webkit-text-stroke: 1px black) {
    .fh1-outline {
      color: var(--fg-dim);
    }
  }
  .fh1-signal {
    color: var(--accent);
  }
  .flight-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
    margin-top: clamp(22px, 4vh, 44px);
    padding-bottom: clamp(24px, 4.5vh, 56px);
  }
  .flight-sub {
    font-size: clamp(15px, 1.25vw, 17.5px);
    color: var(--fg-dim);
    max-width: 44ch;
  }
  .flight-cta-col {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .flight-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .flight-note {
    font-size: 12px;
    letter-spacing: 0.07em;
    color: var(--fg-faint);
  }

  /* ---- flight strip: the real numbers, silk-screened on the bottom rail ---- */
  .flight-strip {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line-2);
    padding: 0 clamp(20px, 4vw, 64px) clamp(16px, 2.5vh, 26px);
    background: linear-gradient(180deg, rgba(5, 4, 3, 0.55), rgba(5, 4, 3, 0.92));
  }
  .strip-trace {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
    padding: 10px 0 12px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .trace-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .trace-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
    flex: none;
  }
  .trace-read {
    color: var(--accent);
    letter-spacing: 0.1em;
    min-height: 1.2em;
  }
  .strip-cells {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0;
  }
  .scell {
    display: grid;
    gap: 3px;
    padding: 2px clamp(18px, 2.6vw, 44px) 0;
    border-left: 1px solid var(--line);
  }
  .scell:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .scell dt {
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .scell dd {
    font-size: clamp(13px, 1.15vw, 16px);
    color: var(--accent-bright);
    margin: 0;
  }
  .scell--wide dd {
    color: var(--fg-dim);
  }
  @media (max-width: 860px) {
    .strip-cells {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px 18px;
    }
    .scell,
    .scell:first-child {
      padding: 0;
      border-left: 0;
    }
    .scell--wide {
      grid-column: 1 / -1;
    }
    .trace-read {
      display: none;
    }
  }

  /* ---- the record section (replay deck + vows) ---- */
  .record {
    padding: 110px 0 0;
  }
  /* scrub runway (Director #5) — .record--scrub is added by ReplayHUD only with
     JS + motion allowed, so static/reduced users never see dead scroll height. */
  .record--scrub .record-runway {
    height: 240vh;
  }
  .record--scrub .record-pin {
    position: sticky;
    top: max(20px, calc(50vh - 300px));
  }
  @media (max-width: 720px) {
    .record--scrub .record-runway {
      height: 200vh;
    }
    .record--scrub .record-pin {
      top: max(12px, calc(50vh - 330px));
    }
  }

  /* ---- the instrument deck ---- */
  .deck {
    background: linear-gradient(180deg, rgba(18, 16, 10, 0.6), rgba(13, 11, 7, 0.85));
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  .deck-rail {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding: 12px 18px 0;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .deck-tag {
    color: var(--fg-dim);
    font-weight: 600;
  }
  .deck-tag i {
    color: var(--accent);
    font-style: normal;
  }
  .deck-grid {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr) 190px;
    gap: 0;
    align-items: stretch;
  }
  .deck-flank {
    display: grid;
    align-content: start;
    gap: 0;
    padding: 22px 18px;
    border-right: 1px solid var(--line);
  }
  .deck-flank--right {
    border-right: 0;
    border-left: 1px solid var(--line);
  }
  .flank-cell {
    display: grid;
    gap: 3px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }
  .flank-cell:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .flank-label {
    font-size: 9.5px;
    letter-spacing: 0.2em;
    color: var(--fg-faint);
  }
  .flank-value {
    font-size: 12px;
    line-height: 1.45;
    color: var(--fg-dim);
  }
  .deck-stage {
    min-width: 0;
    padding: 6px 8px 8px;
  }
  @media (max-width: 1080px) {
    .deck-grid {
      grid-template-columns: 1fr;
    }
    .deck-flank {
      display: none;
    }
  }

  /* ---- the five vows ---- */
  .vows {
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 14px 22px;
    flex-wrap: wrap;
    padding: 18px 2px 26px;
    border-bottom: 1px solid var(--line);
    font-size: 11.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .vows li::before {
    content: "✓ ";
    color: var(--accent);
  }

  /* ---- section shared ---- */
  .section-sub {
    color: var(--fg-dim);
    font-size: 17px;
    max-width: 58ch;
  }

  /* ---- features: the ledger ---- */
  .features {
    padding: 130px 0 110px;
  }
  .features-head {
    display: grid;
    gap: 16px;
    max-width: 720px;
    margin: 26px 0 64px;
  }
  .frows {
    border-bottom: 1px solid var(--line-2);
  }
  .frow {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr) 300px;
    gap: 28px;
    align-items: baseline;
    padding: 26px 2px;
    border-top: 1px solid var(--line-2);
    transition: background 0.3s var(--ease-out);
  }
  .frow:hover {
    background: rgba(242, 237, 228, 0.02);
  }
  .frow-tag {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--fg-faint);
    transition: color 0.3s var(--ease-out);
  }
  .frow:hover .frow-tag {
    color: var(--accent);
  }
  .frow-body {
    display: grid;
    gap: 6px;
  }
  .frow-body h3 {
    font-family: var(--display);
    font-stretch: 116%;
    font-size: clamp(22px, 2.2vw, 26px);
    font-weight: 630;
    letter-spacing: -0.01em;
  }
  .frow-body p {
    color: var(--fg-dim);
    font-size: 14.5px;
    max-width: 60ch;
  }
  .frow-datum {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-align: right;
    color: var(--fg-faint);
  }
  @media (max-width: 920px) {
    .frow {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .frow-datum {
      text-align: left;
    }
  }

  /* ---- receipts: exhibits ---- */
  .receipts {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
    padding: 110px 0 120px;
  }
  .receipts-head {
    display: grid;
    gap: 16px;
    max-width: 720px;
    margin: 26px 0 56px;
  }
  .exhibit {
    border: 1px solid var(--line);
    border-radius: 2px;
    background: linear-gradient(180deg, rgba(18, 16, 10, 0.5), rgba(13, 11, 7, 0.8));
  }
  .exhibit + .exhibit {
    margin-top: 22px;
  }
  .exhibit-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 13px 22px;
    border-bottom: 1px solid var(--line);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--fg-dim);
  }
  .exhibit-stamps {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .stamp {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-dim);
    border: 1px solid var(--line-2);
    border-radius: 2px;
    padding: 3px 9px;
  }
  .stamp--accent {
    color: var(--accent);
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }
  .exhibit-body {
    padding: 26px 22px 28px;
    display: grid;
    gap: 22px;
  }
  .exhibit-body h3 {
    font-family: var(--display);
    font-stretch: 116%;
    font-size: clamp(24px, 2.8vw, 32px);
    font-weight: 630;
    letter-spacing: -0.012em;
  }
  .exhibit-body--trial {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
  }
  .trial-rows {
    display: grid;
    gap: 0;
    font-size: 13px;
  }
  .trial-rows div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 14px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }
  .trial-rows div:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .trial-rows dt {
    color: var(--fg-faint);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 10.5px;
    padding-top: 2px;
  }
  .trial-rows dd {
    color: var(--fg);
  }
  .exhibit-body--session {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
  }
  .session-nums {
    display: flex;
    gap: 0;
    flex-wrap: wrap;
  }
  .snum {
    display: grid;
    gap: 4px;
    padding: 0 34px;
    border-left: 1px solid var(--line);
  }
  .snum:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .snum-value {
    font-size: clamp(34px, 4vw, 46px);
    color: var(--accent-bright);
    line-height: 1.05;
    font-weight: 500;
  }
  .snum-label {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .exhibit-cap {
    font-size: 12px;
    color: var(--fg-faint);
    border-top: 1px solid var(--line);
    padding: 13px 22px 15px;
    line-height: 1.55;
  }
  @media (max-width: 860px) {
    .exhibit-body--trial,
    .exhibit-body--session {
      grid-template-columns: 1fr;
    }
    .snum {
      padding: 0 22px;
    }
  }
  @media (max-width: 560px) {
    .session-nums {
      display: grid;
      gap: 18px;
    }
    .snum {
      padding: 0;
      border-left: 0;
    }
  }

  /* ---- pricing: the manifest ---- */
  .pricing {
    padding: 120px 0 110px;
  }
  .pricing-head {
    display: grid;
    gap: 16px;
    max-width: 720px;
    margin-bottom: 56px;
  }
  .manifest {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 64px;
    align-items: start;
  }
  .manifest-price {
    font-size: 13px;
    letter-spacing: 0.22em;
    color: var(--fg-dim);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .manifest-price b {
    color: var(--fg);
    font-weight: 700;
  }
  .manifest-list {
    list-style: none;
    margin: 22px 0 30px;
    border-bottom: 1px solid var(--line-2);
  }
  .manifest-list li {
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: baseline;
    padding: 13px 2px;
    border-top: 1px solid var(--line-2);
    color: var(--fg);
    font-size: 15.5px;
  }
  .mled-tag {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--fg-faint);
  }
  .mled-mark {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-align: right;
    color: var(--accent);
  }
  .manifest-pro {
    border-left: 1px solid var(--line-2);
    padding-left: 40px;
    display: grid;
    gap: 14px;
    justify-items: start;
    align-content: start;
  }
  .pro-price {
    font-size: 22px;
    color: var(--fg-dim);
  }
  .manifest-list--pro {
    margin: 4px 0 6px;
    border-bottom: 0;
    width: 100%;
  }
  .manifest-list--pro li {
    color: var(--fg-dim);
    font-size: 14px;
    padding: 10px 2px;
  }
  .manifest-list--pro .mled-mark {
    color: var(--fg-faint);
  }
  .pro-note {
    font-size: 13px;
    color: var(--fg-faint);
    max-width: 40ch;
  }
  @media (max-width: 860px) {
    .manifest {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .manifest-pro {
      border-left: 0;
      border-top: 1px solid var(--line-2);
      padding-left: 0;
      padding-top: 40px;
    }
  }

  /* ---- FAQ: split interrogation ---- */
  .faq {
    background: var(--bg-2);
    border-top: 1px solid var(--line);
    padding: 110px 0 120px;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 72px;
    align-items: start;
  }
  .faq-left {
    position: sticky;
    top: 110px;
    display: grid;
    gap: 16px;
  }
  .faq-list {
    border-top: 1px solid var(--line-2);
  }
  .faq-list details {
    border-bottom: 1px solid var(--line-2);
  }
  .faq-list summary {
    cursor: pointer;
    padding: 21px 38px 21px 2px;
    font-size: 16.5px;
