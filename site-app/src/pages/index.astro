        <div class="scell"><dt>avg fps</dt><dd>{flight.avgFps.toFixed(1)}</dd></div>
        <div class="scell"><dt><span title="The average of your worst 1% of frames — the stutter number. Steadier matters more than higher.">1% low</span></dt><dd>{flight.low1FpsEst.toFixed(1)}</dd></div>
        <div class="scell"><dt>duration</dt><dd>{flightClock}</dd></div>
        <div class="scell"><dt>samples</dt><dd>{flightSamples}</dd></div>
        <div class="scell scell--wide"><dt>rig</dt><dd>{flight.gpu} · {flight.display}</dd></div>
      </dl>
    </footer>
  </section>

  <!-- ============ the record: the replay deck, a second REAL session ============ -->
  <section class="record" data-record>
    <!-- scrub runway (Director #5): ReplayHUD arms .record--scrub with JS + motion
         allowed — the runway gains height, the deck pins, and scroll scrubs the real
         session. Static / reduced-motion users get no runway (auto height, no pin). -->
    <div class="record-runway" data-runway>
      <div class="record-pin">
        <div class="wrap">
          <!-- the instrument deck: a REAL recorded Monitor session, scroll-scrubbed -->
          <div class="deck brackets reveal">
        <span class="bkt" aria-hidden="true"></span>
        <div class="deck-rail mono" aria-hidden="true">
