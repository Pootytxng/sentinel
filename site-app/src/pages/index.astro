    </div>

    <footer class="flight-strip mono" data-fx-strip>
      <div class="strip-trace">
        <span class="trace-label">
          <i class="trace-dot" aria-hidden="true"></i>
          live trace — per-second 1% low fps (the worst frames, not the average) · real recorded session · {flightEvents} process events
        </span>
        <span class="trace-read readout" data-play-read aria-hidden="true"></span>
      </div>
