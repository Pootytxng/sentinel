---
// compy.gg home — Mission Control (Direction A, spec 2026-07-14-site-makeover-research-spitball).
// Rebuild 2026-07-14 after owner taste-gate FAIL: art direction is the app's ratified
// instrument-console language (bracketed stage, ruled ledgers, mono telemetry, one accent),
// not a card-grid template. Reference lane: crewed-flight mission-ops console.
// Every number on this page is pinned to a real provenance record:
//   session showcase → ../data/session-replay.json + site/src/session-receipt.json
//   honesty receipt  → site/src/proof-receipt.json
// No gain claims, no fabricated data, zero third-party runtime requests. PRE-PUBLISH.
import Base from "../layouts/Base.astro";
import ReplayHUD from "../components/ReplayHUD.tsx";
import CountUp from "../components/CountUp.tsx";
import replay from "../data/session-replay.json";

const rigParts = replay.rig.split(" · "); // ["AMD Radeon RX 9070 XT", "Ryzen X3D-class 16-thread", "Windows 11"]
const h = Math.floor(replay.durationSecs / 3600);
const m = Math.floor((replay.durationSecs % 3600) / 60);
const s = replay.durationSecs % 60;
const durationClock = `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
const sessionDate = replay.startedAt.slice(0, 10);
const eventCount = replay.events.length;

const modules = [
  {
    tag: "RIG-SCAN",
    title: "Per-rig recommendations",
    desc: "Compy reads your CPU, GPU, RAM and storage first, then recommends only what fits your hardware — not a YouTube preset recorded on someone else's PC.",
    datum: "CPU · GPU · RAM · STORAGE",
  },
  {
    tag: "LEDGER",
    title: "Rollback-first",
    desc: "Every change records its exact prior state in the Trust Ledger before it applies. One click puts it back — even if the tweak is later retired.",
    datum: "PRIOR STATE · RECORDED AT APPLY",
  },
  {
    tag: "LAB",
    title: "The Lab",
    desc: "A benchmark proving ground: apply a tweak, measure it on live game frames, and keep it only if the numbers earn it. Auto-rollback when they don't.",
    datum: "BASELINE VS TREATMENT · LIVE FRAMES",
  },
  {
    tag: "MONITOR",
    title: "Monitor",
    desc: "Live fps, frametimes and GPU telemetry, read on-device. No overlay injection, no kernel driver — anti-cheat safe by design.",
    datum: "ETW · NO INJECTION",
  },
  {
    tag: "GAMING MODE",
    title: "Gaming Mode",
    desc: "Session-scoped tweaks that apply when you start playing and revert when you stop — your PC goes back to normal the moment the session ends.",
    datum: "APPLIES AT START · REVERTS AT STOP",
  },
  {
    tag: "BLACKBOOK",
    title: "The Blackbook",
    desc: "The debunk library: which popular “FPS tweaks” actually do something, which are snake oil, and the evidence either way.",
    datum: "THE DEBUNK LIBRARY",
    href: "/library/",
  },
];
---

<Base
  title="Compy — the PC optimizer that shows its receipts"
  description="Compy reads your actual hardware, recommends only what it can undo, and measures every change on your rig — including the ones that do nothing. Free, no account, nothing leaves your PC."
>
  <!-- decorative viewport HUD corners (desktop only, pointer-through) -->
  <div class="hud-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <!-- ============ topbar ============ -->
  <header class="topbar">
    <div class="wrap topbar-in">
      <a class="mono wordmark" href="/">COMPY</a>
      <span class="mono topbar-status"><span class="status-dot" aria-hidden="true"></span>private beta</span>
      <nav class="topnav mono" aria-label="Site">
        <a href="/library/">Blackbook</a>
        <a href="#receipts">Receipts</a>
        <a href="#faq">FAQ</a>
        <a class="btn btn--primary topnav-cta" href="#waitlist" data-magnetic>Join the waitlist</a>
      </nav>
    </div>
  </header>

  <!-- ============ hero: the statement, then the instrument deck ============ -->
  <section class="hero">
    <div class="grid-tex" aria-hidden="true"></div>
    <div class="hero-bloom" aria-hidden="true"></div>
    <div class="wrap">
      <p class="console-rail mono boot" style="--b: 0">
        <b>measured, not promised</b>
        <span class="console-rail-datum readout" aria-label="Provenance of the session shown below">
          SESSION {sessionDate} · {replay.game.toUpperCase()} · {durationClock}
        </span>
      </p>
      <h1 class="boot" style="--b: 1">The PC optimizer that shows its receipts.</h1>
      <div class="hero-row boot" style="--b: 2">
        <p class="hero-sub">
          Compy reads your actual hardware, recommends only what it can undo, and measures
          every change on your rig — including the ones that do nothing.
        </p>
        <div class="hero-cta-col">
          <div class="hero-ctas">
            <a class="btn btn--primary" href="#waitlist" data-magnetic>Join the waitlist</a>
            <a class="btn btn--ghost" href="/library/" data-magnetic>Read the Blackbook →</a>
          </div>
          <p class="hero-note mono">Compy is free. No account, no ads, nothing leaves your PC.</p>
        </div>
      </div>

      <!-- the instrument deck: a REAL recorded Monitor session, replayable -->
      <div class="deck brackets boot" style="--b: 3">
        <span class="bkt" aria-hidden="true"></span>
        <div class="deck-rail mono" aria-hidden="true">
          <span class="deck-tag">MONITOR <i>//</i> SESSION REPLAY</span>
          <span>READ ON-DEVICE · READ-ONLY</span>
        </div>
        <div class="deck-grid">
          <aside class="deck-flank mono" aria-label="Rig the session was recorded on">
            <div class="flank-cell"><span class="flank-label">GPU</span><span class="flank-value">{rigParts[0]}</span></div>
            <div class="flank-cell"><span class="flank-label">CPU</span><span class="flank-value">{rigParts[1]}</span></div>
            <div class="flank-cell"><span class="flank-label">OS</span><span class="flank-value">{rigParts[2]}</span></div>
          </aside>
          <div class="deck-stage">
            <ReplayHUD client:idle />
          </div>
          <aside class="deck-flank deck-flank--right mono" aria-label="Session record totals">
            <div class="flank-cell"><span class="flank-label">DURATION</span><span class="flank-value readout">{durationClock}</span></div>
            <div class="flank-cell"><span class="flank-label">SAMPLES</span><span class="flank-value readout">{replay.samples.toLocaleString("en-US")}</span></div>
            <div class="flank-cell"><span class="flank-label">EVENTS</span><span class="flank-value readout">{eventCount} recorded</span></div>
          </aside>
        </div>
      </div>

      <!-- the five vows: the deck's bottom rail -->
      <ul class="vows mono boot" style="--b: 4" role="list" aria-label="What Compy will never do">
        <li>rollback-first</li>
        <li>zero outbound connections</li>
        <li>no kernel driver</li>
        <li>no game injection</li>
        <li>free forever</li>
      </ul>
    </div>
  </section>

  <!-- ============ the instrument panel (ledger rows, not cards) ============ -->
  <section id="features" class="features">
    <div class="wrap">
      <div class="rail reveal-rule reveal"><b>THE INSTRUMENT</b><span class="rail-datum">SIX MODULES · ONE LEDGER</span></div>
      <div class="features-head reveal">
        <h2>Built like mission control, not a magic button.</h2>
        <p class="section-sub">
          One dashboard that knows your rig, proves what it changes, and can always put
          things back.
        </p>
      </div>
      <div class="frows" role="list">
        {
          modules.map((mod, i) => (
            <article class="frow reveal" role="listitem" style={`--d: ${(i % 3) * 0.08}s`}>
              <span class="frow-tag mono">{mod.tag}</span>
              <div class="frow-body">
                <h3>{mod.href ? <a href={mod.href}>{mod.title} →</a> : mod.title}</h3>
                <p>{mod.desc}</p>
              </div>
              <span class="frow-datum mono">{mod.datum}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ receipts: two real records, published as-is ============ -->
  <section id="receipts" class="receipts">
    <div class="wrap">
      <div class="rail reveal-rule reveal"><b>RECEIPTS</b><span class="rail-datum">REAL RECORDS · PUBLISHED AS-IS</span></div>
      <div class="receipts-head reveal">
        <h2>We publish the misses too.</h2>
        <p class="section-sub">
          Every optimizer promises. Compy measures — and shows the result either way.
          Exhibit A is a tweak that did nothing, published anyway. Exhibit B is the session
          from the replay above — the full record behind those numbers.
        </p>
      </div>

      <article class="exhibit reveal" aria-label="A measured null result">
        <header class="exhibit-head mono">
          <span class="exhibit-id">EXHIBIT A — LAB TRIAL</span>
          <span class="exhibit-stamps">
            <span class="stamp stamp--accent">measured ✓</span>
            <span class="stamp">rolled back ✓</span>
          </span>
        </header>
        <div class="exhibit-body exhibit-body--trial">
          <h3>Windows Game Mode — did it help?</h3>
          <dl class="trial-rows readout">
            <div><dt>trial</dt><dd>5 baseline vs 5 treatment windows, live game frames</dd></div>
            <div><dt>result</dt><dd>no gain beyond the ±0.7% session noise floor</dd></div>
            <div><dt>rollback</dt><dd>restored to the exact prior value ✓</dd></div>
          </dl>
        </div>
        <footer class="exhibit-cap mono">
          A real Lab trial, published as-is. When a tweak does nothing, Compy says so —
          that's the honesty test.
        </footer>
      </article>

      <article class="exhibit exhibit--session reveal" aria-label="A real recorded session">
        <header class="exhibit-head mono">
          <span class="exhibit-id">EXHIBIT B — MONITOR SESSION</span>
          <span class="exhibit-stamps">
            <span class="stamp stamp--accent">measured ✓</span>
            <span class="stamp">{sessionDate}</span>
          </span>
        </header>
        <div class="exhibit-body exhibit-body--session">
          <h3>Diablo IV — three hours, measured live</h3>
          <div class="session-nums">
            <div class="snum">
              <span class="snum-value readout"><CountUp client:visible value={237.3} decimals={1} /></span>
              <span class="snum-label mono">avg fps</span>
            </div>
            <div class="snum">
              <span class="snum-value readout"><CountUp client:visible value={214.4} decimals={1} /></span>
              <span class="snum-label mono">1% low</span>
            </div>
            <div class="snum">
              <span class="snum-value readout"><CountUp client:visible value={10776} /></span>
              <span class="snum-label mono">samples</span>
            </div>
          </div>
        </div>
        <footer class="exhibit-cap mono">
          The same recorded session as the replay deck above — {rigParts[0]} · every number
          read on-device and graphed in Monitor. A measurement showcase —
          Compy claims none of it as its own doing.
        </footer>
      </article>
    </div>
  </section>

  <!-- ============ pricing: the manifest ============ -->
  <section id="pricing" class="pricing">
    <div class="wrap">
      <div class="pricing-head reveal">
        <h2>Free forever. Really.</h2>
        <p class="section-sub">The optimizer, the rollback, the receipts — none of it is behind a paywall.</p>
      </div>
      <div class="manifest">
        <div class="manifest-free reveal">
          <p class="manifest-price mono">COMPY — <b>FREE FOREVER</b></p>
          <ul class="manifest-list" role="list">
            <li>Per-rig recommendations, all of them</li>
            <li>Trust Ledger rollback, unlimited</li>
            <li>Monitor, the Lab, Gaming Mode</li>
            <li>No account · no ads · no upsell nags</li>
          </ul>
          <a class="btn btn--primary" href="#waitlist" data-magnetic>Join the waitlist</a>
        </div>
        <article class="pcard--pro manifest-pro reveal" style="--d: 0.1s">
          <p class="manifest-price mono manifest-price--pro">COMPY PRO <span class="stamp">in the works</span></p>
          <p class="pro-price readout">No price yet</p>
          <ul class="manifest-list manifest-list--pro" role="list">
            <li>Long-term monitoring history</li>
            <li>Multi-rig dashboards</li>
          </ul>
          <p class="pro-note">
            Nothing to buy until it's real — and Pro will never be required to optimize or
            roll back.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ FAQ: interrogation, split layout ============ -->
  <section id="faq" class="faq">
    <div class="wrap faq-grid">
      <div class="faq-left reveal">
        <h2>The questions worth asking an optimizer.</h2>
        <p class="section-sub">
          Straight answers — the same confidence labels the app itself uses.
        </p>
      </div>
      <div class="faq-list reveal" style="--d: 0.1s">
        <details>
          <summary>Is Compy really free?</summary>
          <p>
            Yes — free forever, not a trial. A paid Pro tier (monitoring history, multi-rig)
            is in the works, but everything Compy does today stays free.
          </p>
        </details>
        <details>
          <summary>Can I undo what it changes?</summary>
          <p>
            Always. Before any change applies, Compy records the exact prior state in its
            Trust Ledger. Rollback restores that recorded value — it works even if the tweak
            is later removed from the catalog, and it never applies anything it can't undo.
          </p>
        </details>
        <details>
          <summary>Will it get me banned by anti-cheat?</summary>
          <p>
            No. Compy never injects into games and never installs a kernel driver — the two
            things anti-cheat systems actually punish. Fps and telemetry are read through
            Windows' own event tracing and GPU vendor libraries.
          </p>
        </details>
        <details>
          <summary>Does Compy send my data anywhere?</summary>
          <p>
            No. The app makes zero outbound connections — your hardware info, sessions and
            history never leave your PC. The only thing this website stores is the waitlist
            email you choose to give it.
          </p>
        </details>
        <details>
          <summary>Does it support my hardware?</summary>
          <p>
            AMD GPUs are hardware-verified (it's built on one). NVIDIA detection and
            NVIDIA-specific tweaks are verified on real hardware; NVIDIA sensor monitoring is
            implemented but not yet hardware-verified. Intel GPU support is planned. We label
            confidence honestly rather than claiming everything works everywhere.
          </p>
        </details>
        <details>
          <summary>How much FPS will I gain?</summary>
          <p>
            We won't promise a number — nobody honestly can, because it depends on your rig.
            Compy measures each change on your PC and shows you the result, including when
            it's nothing. That's the entire point.
          </p>
        </details>
        <details>
          <summary>When can I download it?</summary>
          <p>
            Compy is in private beta. Join the waitlist below and you'll get one email when
            the public build is ready — that's the only thing the list is for.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- ============ waitlist: the terminal ============ -->
  <section id="waitlist" class="waitlist">
    <div class="wrap">
      <div class="terminal brackets reveal">
        <span class="bkt" aria-hidden="true"></span>
        <div class="deck-rail mono" aria-hidden="true">
          <span class="deck-tag">LAUNCH LIST</span>
          <span>ONE EMAIL · NOTHING ELSE</span>
        </div>
        <div class="terminal-in">
          <h2>Be first in line.</h2>
          <p class="section-sub">One email when Compy launches. That's it.</p>
          <form class="waitlist-form" method="POST" action="/api/waitlist" data-waitlist>
            <span class="prompt mono" aria-hidden="true">&gt;</span>
            <input type="email" name="email" required placeholder="you@example.com" aria-label="Email address" />
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
            <button class="btn btn--primary" type="submit" data-magnetic>Notify me</button>
          </form>
          <p class="waitlist-pending mono" data-waitlist-status role="status"></p>
          <p class="waitlist-privacy mono">
            Your email is stored only to send that one launch message — no list-selling, no
            follow-up drip. The app itself sends nothing off your PC.
          </p>
          <!-- KO-FI PLACEHOLDER SLOT: support link appears here once the owner sets a profile URL. -->
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import "../scripts/motion.ts";

  // Waitlist progressive enhancement — same-origin /api/waitlist only (no JS still works:
  // the form natively POSTs and comes back as /?waitlist=ok).
  const wlForm = document.querySelector<HTMLFormElement>("[data-waitlist]");
  const wlStatus = document.querySelector<HTMLElement>("[data-waitlist-status]");
  const setStatus = (msg: string) => {
    if (wlStatus) wlStatus.textContent = msg;
  };
  const wlFlag = new URLSearchParams(location.search).get("waitlist");
  if (wlFlag === "ok") setStatus("You're on the list. One email at launch — that's it.");
  if (wlFlag === "err") setStatus("Something went wrong — try again in a minute.");
  wlForm?.addEventListener("submit", (ev) => {
    ev.preventDefault();
    setStatus("…");
    fetch("/api/waitlist", {
      method: "POST",
      body: new FormData(wlForm),
      headers: { accept: "application/json" },
    })
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        wlForm.reset();
        setStatus("You're on the list. One email at launch — that's it.");
      })
      .catch(() => setStatus("Something went wrong — try again in a minute."));
  });
</script>

