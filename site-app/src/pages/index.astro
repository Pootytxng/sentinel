  /* ---- hero ---- */
  .hero {
    padding: 110px 0 84px;
    overflow: hidden;
  }
  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 56px;
    align-items: center;
    position: relative;
  }
  .hero-copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .hero-sub {
