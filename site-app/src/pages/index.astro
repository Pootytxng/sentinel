---
// compy.gg home — FLIGHT TEST (owner-approved rework 2026-07-15).
// Art direction: the real session data IS the art. Pure-black field, one hot signal
// amber, monumental kinetic display type, and a full-viewport canvas waveform drawn
// from an ACTUAL recorded Monitor session (per-second 1% low fps — never presented
// as anything else). Boot preloader counts the real sample total. Crosshair cursor
// reads real values off the trace.
// Every number on this page is pinned to a real provenance record:
//   hero waveform   → ../data/flight-session.json (Marvel Rivals, 2026-06-25)
//   session showcase → ../data/session-replay.json + site/src/session-receipt.json
//   honesty receipt  → site/src/proof-receipt.json
// No gain claims, no fabricated data, zero third-party runtime requests.
import Base from "../layouts/Base.astro";
import ReplayHUD from "../components/ReplayHUD.tsx";
import CountUp from "../components/CountUp.tsx";
import replay from "../data/session-replay.json";
import flight from "../data/flight-session.json";

const rigParts = replay.rig.split(" · "); // ["AMD Radeon RX 9070 XT", "Ryzen X3D-class 16-thread", "Windows 11"]
const h = Math.floor(replay.durationSecs / 3600);
const m = Math.floor((replay.durationSecs % 3600) / 60);
const s = replay.durationSecs % 60;
const durationClock = `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
const sessionDate = replay.startedAt.slice(0, 10);
const eventCount = replay.events.length;

// flight-session (the hero trace) — REAL record, see the JSON's provenance note
const fm = Math.floor(flight.durationSecs / 60);
const fs = flight.durationSecs % 60;
const flightClock = `${fm}:${String(fs).padStart(2, "0")}`;
const flightDate = flight.startedAt.slice(0, 10);
const flightSamples = flight.samples.toLocaleString("en-US");
const flightEvents = flight.events.length;

const modules = [
  {
    tag: "RIG-SCAN",
    title: "Per-rig recommendations",
    desc: "Compy reads your CPU, GPU, RAM and storage first, then recommends only what fits your hardware — not a YouTube preset recorded on someone else's PC.",
    datum: "CPU · GPU · RAM · STORAGE",
  },
  {
    tag: "LEDGER",
    title: "Rollback-first",
    desc: "Every change records its exact prior state in the Trust Ledger before it applies. One click puts it back — even if the tweak is later retired.",
    datum: "PRIOR STATE · RECORDED AT APPLY",
  },
  {
    tag: "LAB",
    title: "The Lab",
    desc: "A benchmark proving ground: apply a tweak, measure it on live game frames, and keep it only if the numbers earn it. Auto-rollback when they don't.",
    datum: "BASELINE VS TREATMENT · LIVE FRAMES",
  },
  {
    tag: "MONITOR",
    title: "Monitor",
    desc: "Live fps, frametimes and GPU telemetry, read on-device. No overlay injection, no kernel driver — anti-cheat safe by design.",
    datum: "ETW · NO INJECTION",
  },
  {
    tag: "GAMING MODE",
    title: "Gaming Mode",
    desc: "Session-scoped tweaks that apply when you start playing and revert when you stop — your PC goes back to normal the moment the session ends.",
    datum: "APPLIES AT START · REVERTS AT STOP",
  },
  {
    tag: "BLACKBOOK",
    title: "The Blackbook",
    desc: "Every popular “FPS tweak,” graded: real, placebo, or risky. Every verdict is public — the full write-ups live in the app, next to your own measurements.",
    datum: "EVERY VERDICT PUBLIC · THE BOOK SHIPS IN THE APP",
    href: "/library/",
  },
];
---

<Base
  title="Compy — the PC optimizer that shows its receipts"
  description="Compy reads your actual hardware, recommends only what it can undo, and measures every change on your rig — including the ones that do nothing. The core is free forever — no account, no telemetry."
  jsonld={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Compy",
    operatingSystem: "Windows",
    applicationCategory: "UtilitiesApplication",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    url: "https://compy.gg/",
  }).replace(/</g, "\\u003c")}
>
  <!-- ============ boot preloader (revealed by the inline script ONLY when JS runs
       and the user allows motion; no-JS / reduced-motion users never see it) ============ -->
  <div class="boot-shell mono" data-boot hidden aria-hidden="true">
    <div class="boot-in">
      <span class="boot-tag">COMPY <i>//</i> SESSION RECORD</span>
      <span class="boot-count readout"><b data-boot-count>0</b><i>/ {flightSamples} samples</i></span>
      <span class="boot-rule"><i data-boot-rule></i></span>
      <span class="boot-src">{flight.game.toUpperCase()} · {flightDate} · READ ON-DEVICE</span>
    </div>
  </div>
  <script is:inline>
    // Arm the boot overlay before the hero parses (zero content flash). Motion-gated:
    // reduced-motion users go straight to the finished page. A 5s failsafe clears the
    // overlay even if the module bundle never runs.
    (function () {
      try {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var b = document.querySelector("[data-boot]");
        if (!b) return;
        b.hidden = false;
        document.documentElement.classList.add("booting");
        setTimeout(function () {
          if (!b.hasAttribute("data-boot-done")) {
            b.remove();
            document.documentElement.classList.remove("booting");
          }
        }, 5000);
      } catch (e) {}
    })();
  </script>

  <!-- decorative viewport HUD corners (desktop only, pointer-through) -->
  <div class="hud-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <!-- ============ topbar ============ -->
  <header class="topbar">
    <div class="wrap topbar-in">
      <a class="mono wordmark" href="/">COMPY</a>
      <span class="mono topbar-status"><span class="status-dot" aria-hidden="true"></span>private beta</span>
      <nav class="topnav mono" aria-label="Site">
        <a href="#receipts">Receipts</a>
        <a href="/library/">Blackbook</a>
        <a href="/compare">Compare</a>
        <a href="#faq">FAQ</a>
        <a class="btn btn--primary topnav-cta" href="#waitlist" data-magnetic>Join the waitlist</a>
      </nav>
    </div>
  </header>

  <!-- ============ flight hero: the real session IS the art ============ -->
